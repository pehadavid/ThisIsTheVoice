+/**
+   Remote controls page.
+
+   A named set of up to 8 parameters that hardware controllers map onto their knobs.
+   Several pages may share a section, and a parameter may appear on several pages.
+   @see Plugin::initRemoteControlsPage(uint32_t, RemoteControlsPage&)
+ */
+struct RemoteControlsPage {
+   /**
+      Number of parameter slots on a page.
+    */
+    static constexpr const uint32_t kSlotCount = 8;
+
+   /**
+      Name of the section the page belongs to, such as a module of the plugin.
+    */
+    String section;
+
+   /**
+      Name of the page.
+    */
+    String name;
+
+   /**
+      Index of the parameter in each slot, or -1 for an empty slot.
+    */
+    int32_t parameters[kSlotCount];
+
+   /**
+      Default constructor for an empty page.
+    */
+    RemoteControlsPage() noexcept
+        : section(),
+          name()
+    {
+        for (uint32_t i = 0; i < kSlotCount; ++i)
+            parameters[i] = -1;
+    }
+};
+
